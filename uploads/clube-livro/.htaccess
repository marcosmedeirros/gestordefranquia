# Os arquivos do Clube do Livro.
#
# AQUI NADA É SERVIDO PELA WEB. Esta pasta é a única do projeto que nega
# TUDO, inclusive o que ela guarda — e é de propósito.
#
# O .htaccess de uploads/ tem uma lista de extensões permitidas, e `pdf` está
# nela. Sem este arquivo, um PDF daqui sairia por /uploads/clube-livro/<nome>
# sem passar por lugar nenhum, e a regra de "só quem está no clube baixa"
# valeria só pra quem usasse o link da tela. O nome em disco é sorteado, o que
# torna o endereço difícil de adivinhar — mas endereço difícil não é controle
# de acesso, é só um segredo mal guardado.
#
# Quem entrega é /clube-livro-arquivo.php, que pergunta quem está pedindo
# antes de abrir o arquivo. A pasta existe só pra guardar.
#
# Escrito pras duas gerações do Apache: o 2.4 lê o bloco <IfModule
# authz_core>, o 2.2 (e o 2.4 com mod_access_compat) lê o outro. Sem os dois,
# um servidor entende e o outro ignora calado.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
</IfModule>

# E, se alguma configuração acima ainda deixar algo passar, que ao menos não
# seja executado: um .php que chegue aqui é texto, nunca código.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar
RemoveType    .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar
AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .sh .jsp .asp

Options -Indexes -ExecCGI
