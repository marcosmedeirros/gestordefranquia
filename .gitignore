/uploads/pathetic/*
!/uploads/pathetic/.htaccess

# Dumps do banco: 24MB de dados reais dos usuarios (e-mail, hash de senha).
# O .htaccess ja nega .sql pela web, mas isso nao tem por que viajar no repo.
# Como obter: LOCAL_SETUP.md.
bancos_local_test/*.sql

# Dump comprimido vindo de producao (mesmo motivo dos .sql)
bancos_local_test/*.sql.gz
