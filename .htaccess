# Habilitar log de erros
php_flag display_errors On
php_flag log_errors On

# Manter sessão por 90 dias (evita deslogar ao fechar o browser)
php_value session.cookie_lifetime 7776000
php_value session.gc_maxlifetime 7776000

# Upload de vídeos de liga (Progression/Sistemas/Free Agency) — servidor
# costuma vir com limite baixo por padrão, insuficiente pra vídeo.
php_value upload_max_filesize 300M
php_value post_max_size 300M
php_value max_execution_time 300
php_value max_input_time 300

# Charset padrão
AddDefaultCharset UTF-8

# Favicon & ícones antigos -> novos caminhos
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Favicon padrão (PNG funciona em navegadores modernos)
    RewriteRule ^favicon\.ico$ /img/icons/icon-96.png [L]
    
    # Compatibilidade com caminhos antigos
    RewriteRule ^img/fba-logo\.png$ /img/icons/icon-180.png [L]
    RewriteRule ^img/icon-192\.png$ /img/icons/icon-192.png [L]
    RewriteRule ^img/icon-96\.png$ /img/icons/icon-96.png [L]
    RewriteRule ^img/icon-48\.png$ /img/icons/icon-48.png [L]

    # O sitemap virou dinâmico (lista as matérias do The Pathetic, que são o
    # conteúdo novo do site). O endereço /sitemap.xml continua valendo —
    # é o que está no robots.txt e o que o Google já conhece; trocar o
    # endereço custaria uma nova descoberta sem ganho nenhum.
    RewriteRule ^sitemap\.xml$ /sitemap.php [L]
</IfModule>

# Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de recursos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Rewrite rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Redirecionar para HTTPS (descomente se tiver SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Bloquear acesso a arquivos sensíveis
    RewriteRule ^\.git - [F,L]
    RewriteRule ^backend/config\.php$ - [F,L]
    RewriteRule ^sql/ - [F,L]

    # Compatibilidade: links antigos de reset com /games/auth/...
    RewriteRule ^games/auth/resetar\.php$ /auth/resetar.php [L,R=301]

    # Páginas públicas de times: /times/{slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^times/([^/]+)/?$ /times/index.php?slug=$1 [L,QSA]

    # Webhook público de trades
    RewriteRule ^webhook$ /webhook.php [L,QSA]
</IfModule>

# Proteção de arquivos
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
